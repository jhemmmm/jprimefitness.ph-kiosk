# Inlined into the bundle at build time (EXPO_PUBLIC_*). Copy to .env for local
# builds; EAS builds don't see this file, so set the same keys as EAS environment
# variables. Blank values fall back to the defaults in lib/config.ts.

# Must match KIOSK_TOKEN in the backend .env (sent as X-Kiosk-Token).
EXPO_PUBLIC_KIOSK_TOKEN=dev-kiosk-token
# Inactivity before returning to Home.
EXPO_PUBLIC_IDLE_TIMEOUT_MS=60000
# Online-payment QR validity window.
EXPO_PUBLIC_PAYMENT_TIMEOUT_SEC=120
# Result screen auto-redirect countdown.
EXPO_PUBLIC_RESULT_DISPLAY_SEC=8
# Public backend URL for online payments; blank = use the discovered LAN URL.
EXPO_PUBLIC_LIVE_API_URL=https://jprimefitness.ph
